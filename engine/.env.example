# Gemini
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS (comma-separated origins). Use * only for quick demos.
CORS_ORIGINS=*

# Firebase / Firestore credentials
# Option A (recommended on Cloud Run): use service account + GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-sa.json
#
# Option B: pass full service account JSON as a single env var value
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
